{
  "name": "8bitobscura-com",              // MUST match the Cloudflare project name
  "compatibility_date": "2026-09-01",
  // "routes" is added once the custom domains are attached in the dashboard.
  // It is AUTHORITATIVE: any hostname not listed is deleted on deploy.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
